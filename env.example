# Firebase Configuration
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Google Gemini API (development only — production uses Firebase Functions proxy)
VITE_GEMINI_API_KEY=

# Feature flags
VITE_ENABLE_DEMO_AUTH=false
VITE_ENABLE_SW_LOCAL=false

# Google Maps (the /map page)
# Both are PUBLIC client values, like the Firebase web config — the key is
# secured by an HTTP-referrer restriction in the Google Cloud console, not by
# secrecy. VITE_GOOGLE_MAPS_ID is required: AdvancedMarker will not render
# without a map ID, and the map silently shows no pins.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_ID=

# Optional: Analytics
VITE_GA_TRACKING_ID=

# Development/Production Mode
# This is set automatically by Vite, no need to change
# NODE_ENV=production
