rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isStl() {
      return request.resource.contentType == 'application/octet-stream'
        || request.resource.contentType == 'model/stl'
        || request.resource.name.matches('.*\\.stl$');
    }

    function underSize(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024;
    }

    // Shared folders are create-only. `write` also grants update and delete,
    // and every file name is public in its download URL, so any signed-in
    // user could overwrite or delete another user's image. Uploads always
    // use a fresh `${Date.now()}_name` and the client never deletes, so
    // create is all the app needs.
    match /posts/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() && isImage() && underSize(10);
    }

    match /market/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() && isImage() && underSize(10);
    }

    match /avatars/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() && isImage() && underSize(5);
    }

    match /builds/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() && isImage() && underSize(10);
    }

    match /stl_images/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() && isImage() && underSize(10);
    }

    match /stl_files/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() && isStl() && underSize(50);
    }

    // One folder per pilot. The map is public, so the read is public; the
    // write is not, or any signed-in user could replace someone else's photo.
    match /spots/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
        && request.auth.uid == userId
        && isImage()
        && underSize(10);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
