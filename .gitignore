# Environment variables - never commit secrets
# `.env*` catches every variant (.env, .env.local, .env.backup-*, .env.*.bak);
# `env.example` is the committed template and is re-allowed below.
.env*
!env.example
env.download

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Vite / TypeScript cache
*.local
.vite/
# esbuild scratch files Vite leaves behind when loading a TS config
*.timestamp-*.mjs

# Editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Firebase
.firebase/
firebase-debug.log
firebase-service-account.json

# stray local backups
.env.*.bak
.claude/settings.local.json
