{
  "name": "dronehubgeorgia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node generate-sitemap.mjs",
    "build": "node ./node_modules/typescript/bin/tsc && node ./node_modules/vite/bin/vite.js build && node scripts/audit-dist-secrets.mjs",
    "deploy": "npm run build && firebase deploy",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --ext ts,tsx,js --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy:hosting": "node scripts/deploy-hosting.mjs",
    "backup": "node scripts/backup-firestore.mjs && node scripts/backup-storage.mjs",
    "backup:all": "bash scripts/backup-all.sh",
    "brand:import": "node scripts/process-brand-kit.mjs",
    "lint:strict": "node ./node_modules/eslint/bin/eslint.js . --ext ts,tsx,js --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.10.0",
    "date-fns": "^4.1.0",
    "firebase": "^13.0.0",
    "framer-motion": "^11.18.2",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "sitemap": "^9.0.1",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
